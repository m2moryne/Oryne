# Where the dashboard finds the Oryne API. Unset, `npm run dev:web` uses
# http://localhost:8787 and production builds use https://testnet-apiv1.oryne.org.
VITE_ORYNE_API_URL=http://localhost:8787

# Live mode: the mainnet API. Unset, the dashboard's Live
# switch explains that live mode opens with mainnet and everything stays on testnet.
# VITE_ORYNE_LIVE_API_URL=https://apiv1.oryne.org
