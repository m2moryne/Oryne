# Where the dashboard finds the Oryne API. Unset, `npm run dev:web` uses
# http://localhost:8787 and production builds use https://oryne.onrender.com.
VITE_ORYNE_API_URL=http://localhost:8787

# Live mode: the mainnet API (render.mainnet.yaml). Unset, the dashboard's Live
# switch explains that live mode opens with mainnet and everything stays on testnet.
# VITE_ORYNE_LIVE_API_URL=https://oryne-api-mainnet.onrender.com
