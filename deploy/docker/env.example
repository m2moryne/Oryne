# deploy/docker/.env: read by docker compose itself (not by the containers).
#   cp deploy/docker/env.example deploy/docker/.env

# Services that only start when listed here. mainnet = the mainnet API (real
# USDC): add it once env/api-mainnet.env is filled in.
COMPOSE_PROFILES=

# The APIs the website's dashboard talks to, baked into the `web` image at build time.
VITE_ORYNE_API_URL=https://testnet-apiv1.oryne.org
VITE_ORYNE_LIVE_API_URL=https://apiv1.oryne.org
