# /etc/oryne/api-mainnet.env: the MAINNET API's settings (real USDC).
#   sudo install -m 640 -o root -g oryne deploy/env/api-mainnet.env.example /etc/oryne/api-mainnet.env
# This file holds keys that control real money. Only root and the oryne user
# may read it. Never copy it to a laptop, chat or ticket.
# Values marked FROM RENDER must be copied from the oryne-api-mainnet service
# on Render (Environment tab) when moving off Render.

ORYNE_NETWORK=mainnet
HOST=127.0.0.1
PORT=8789
PUBLIC_URL=https://api.oryne.org
WEB_URL=https://oryne.org
CORS_ORIGINS=https://oryne.org,https://www.oryne.org
ORYNE_DATA_DIR=/var/lib/oryne/mainnet

# A separate database from testnet's. On this server:
#   postgresql://oryne_mainnet:<password>@127.0.0.1:5432/oryne_mainnet
DATABASE_URL=

# FROM RENDER. Pays network fees and deploys wallets (holds XLM).
SPONSOR_SECRET=
# Most XLM the sponsor may spend on fees per UTC day.
SPONSOR_DAILY_XLM=5

# FROM RENDER, and it must never change: the agent-wallet code new wallets are
# deployed from. A different value would deploy different contract code.
WALLET_WASM_HASH=

# FROM RENDER. Sends the USDC for card top-ups (holds USDC and a little XLM).
TREASURY_SECRET=

# invite: only accounts approved in the admin site can create a wallet. open at launch.
LIVE_ACCESS=invite
ACTIVATION_USDC=5

ADMIN_TOKEN=
ADMIN_URL=https://adminweb.oryne.org

RESEND_API_KEY=
EMAIL_FROM=Oryne <noreply@oryne.org>

# Paystack LIVE key (sk_live_…). Webhook in Paystack (live mode):
#   https://api.oryne.org/v1/paystack/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=KES
PAYSTACK_RATE=130

DEEPSEEK_API_KEY=

# OAuth callback URLs to register:
#   https://api.oryne.org/v1/auth/oauth/google/callback
#   https://api.oryne.org/v1/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Strongly recommended on mainnet: a paid Stellar RPC provider, so a busy
# public endpoint never stalls payments. Default: https://mainnet.sorobanrpc.com
# STELLAR_RPC_URL=
