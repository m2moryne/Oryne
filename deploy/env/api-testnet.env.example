# The testnet API's settings. Copied to deploy/docker/env/api-testnet.env
# (see deploy/docker/README.md), then fill in the blanks.

ORYNE_NETWORK=testnet
HOST=127.0.0.1
PORT=8787
# This API's public address: goes into 402 responses and OAuth callback URLs.
PUBLIC_URL=https://testnet-apiv1.oryne.org
# The website (OAuth sign-in returns here) and the browser origins allowed to call the API.
WEB_URL=https://oryne.org
CORS_ORIGINS=https://oryne.org,https://www.oryne.org
# Used only if DATABASE_URL is unset (SQLite), and for anything written to disk.
ORYNE_DATA_DIR=/var/lib/oryne/testnet

# Postgres: postgresql://user:password@host:5432/database. Unset: SQLite in ORYNE_DATA_DIR.
DATABASE_URL=

# The account that pays fees, and the issuer of the test USDC. Changing them
# means a new test USDC that no existing wallet holds.
SPONSOR_SECRET=
TOKEN_ISSUER_SECRET=

# Testnet: "Continue as a test user", and the passkey flow in scripts/e2e.ts.
DEV_LOGIN=1

# Admin site (apps/admin): 32+ random characters, and its address.
ADMIN_TOKEN=
ADMIN_URL=https://adminweb.oryne.org

# "Continue with email" (resend.com). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Oryne <noreply@oryne.org>

# Card top-ups: Paystack TEST key (sk_test_…). Webhook in Paystack (test mode):
#   https://testnet-apiv1.oryne.org/v1/paystack/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=KES
PAYSTACK_RATE=130

# AI debugger in the developer console.
DEEPSEEK_API_KEY=

# OAuth apps. Callback URLs to register:
#   https://testnet-apiv1.oryne.org/v1/auth/oauth/google/callback
#   https://testnet-apiv1.oryne.org/v1/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: a dedicated Stellar RPC instead of the public one.
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
