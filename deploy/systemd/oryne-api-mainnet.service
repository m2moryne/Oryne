# The Oryne API on Stellar MAINNET (live mode, real USDC). See deploy/README.md.
# Install: sudo cp deploy/systemd/*.service /etc/systemd/system/ && sudo systemctl daemon-reload

[Unit]
Description=Oryne API (Stellar mainnet)
After=network-online.target postgresql.service
Wants=network-online.target
# Never give up restarting.
StartLimitIntervalSec=0

[Service]
Type=simple
User=oryne
Group=oryne
WorkingDirectory=/opt/oryne/services/api
EnvironmentFile=/etc/oryne/api-mainnet.env
ExecStart=/usr/bin/node src/server.ts
Restart=always
RestartSec=5
TimeoutStartSec=180
MemoryMax=768M
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/oryne/mainnet

[Install]
WantedBy=multi-user.target
