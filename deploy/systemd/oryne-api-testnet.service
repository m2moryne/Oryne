# The Oryne API on Stellar testnet. See deploy/README.md.
# Install: sudo cp deploy/systemd/*.service /etc/systemd/system/ && sudo systemctl daemon-reload

[Unit]
Description=Oryne API (Stellar testnet)
After=network-online.target postgresql.service
Wants=network-online.target
# Never give up restarting.
StartLimitIntervalSec=0

[Service]
Type=simple
User=oryne
Group=oryne
WorkingDirectory=/opt/oryne/services/api
EnvironmentFile=/etc/oryne/api-testnet.env
ExecStart=/usr/bin/node src/server.ts
Restart=always
RestartSec=5
# The first start can upload the wallet contract, which takes a while.
TimeoutStartSec=180
MemoryMax=768M
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/oryne/testnet

[Install]
WantedBy=multi-user.target
