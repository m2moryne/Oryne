# The agent's secret key (S…). Oryne dashboard → Agents → Connect agent; it's shown once.
ORYNE_AGENT_SECRET=

# The model: any OpenAI-compatible chat API. DeepSeek by default (platform.deepseek.com → API keys).
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# For OpenAI instead: LLM_BASE_URL=https://api.openai.com/v1 and LLM_MODEL=gpt-4o-mini

# Testnet (free test USDC). For mainnet: https://apiv1.oryne.org, with an agent from Live mode.
ORYNE_API_URL=https://testnet-apiv1.oryne.org

# The paid services the agent buys from: Oryne's demo merchant, on testnet.
MERCHANT_URL=https://demo.oryne.org
