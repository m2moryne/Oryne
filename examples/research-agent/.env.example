# The agent's secret key (S…). Oryne dashboard → Agents → Connect agent; it's shown once.
ORYNE_AGENT_SECRET=

# DeepSeek API key: platform.deepseek.com → API keys.
DEEPSEEK_API_KEY=

# Testnet (free test USDC). For mainnet: https://oryne-api-mainnet.onrender.com, with an agent from Live mode.
ORYNE_API_URL=https://oryne.onrender.com

# The paid services the agent buys from: Oryne's demo merchant, on testnet.
MERCHANT_URL=https://oryne-demo-merchant.onrender.com
