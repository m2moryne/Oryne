{
  "name": "oryne",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:web": "npm run dev -w @oryne/web",
    "dev:api": "npm run dev -w @oryne/api",
    "build": "npm run build -w @oryne/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "dev:merchant": "npm run dev -w @oryne/demo-merchant",
    "mcp": "npm start -w @oryne/mcp",
    "setup": "node scripts/setup.ts",
    "e2e": "node scripts/e2e.ts"
  },
  "overrides": {
    "rolldown": "1.2.12",
    "vite": "8.3.2"
  }
}
