# Copy to .env. Everything is optional on testnet: missing keys and the test
# USDC are created on first start and stored in services/api/data/.

ORYNE_NETWORK=testnet

# Postgres (e.g. Supabase: Connect → Session pooler). Unset, records go to a
# SQLite file in services/api/data/, which is fine for local development.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
PORT=8787
# Browser origins allowed to call the API (the web app).
CORS_ORIGINS=http://localhost:5173
# Public URL of this API; put in 402 responses and used for OAuth callbacks.
PUBLIC_URL=http://localhost:8787
# The dashboard; OAuth sign-in returns here.
WEB_URL=http://localhost:5173

# "Continue with Google" — see README, "Google and GitHub sign-in".
# Authorized redirect URI: http://localhost:8787/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "Continue with GitHub". Callback URL: http://localhost:8787/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin site (apps/admin). Off when unset. Use 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ADMIN_TOKEN=
# The admin site's address; always allowed to call the API.
# ADMIN_URL=http://localhost:5175

# "Continue with email": codes are sent with Resend from EMAIL_FROM (a verified
# domain). Unset: with DEV_LOGIN=1 the code is printed to this log instead.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Oryne <sign-in@oryne.org>

# AI debugger in the developer console (Claude). Off when unset.
# ANTHROPIC_API_KEY=sk-ant-...

# Testnet only: adds "Continue as a test user" (and lets scripts/e2e.ts run the passkey flow).
DEV_LOGIN=1

# Account that pays fees and deploys wallets. Required on mainnet.
# SPONSOR_SECRET=S...
# Testnet: issuer of the test USDC. Set it (with SPONSOR_SECRET) wherever the data
# directory doesn't survive restarts, such as Render's free plan, so the same
# sponsor and token come back. `npm run keys -w @oryne/api` prints both from data/.
# TOKEN_ISSUER_SECRET=S...
# Token agents spend. On mainnet this defaults to Circle's USDC.
# TOKEN_ID=C...
# Agent-wallet wasm: an already-uploaded hash, or a path/URL to upload from.
# WALLET_WASM_HASH=
# WALLET_WASM=https://github.com/m2moryne/Oryne/releases/download/contracts-latest/agent_wallet.wasm
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
