{
  "name": "@oryne/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Oryne API: wallets, agents, approvals, and the x402 facilitator that settles agent payments on Stellar.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "keys": "node --env-file-if-exists=.env src/keys.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@oryne/core": "*",
    "@stellar/stellar-sdk": "^17.2.1",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
